<Window x:Class="OpenAEC.Sheets.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:models="clr-namespace:OpenAEC.Sheets.Core.Models;assembly=OpenAEC.Sheets.Core"
        Title="OpenAEC Sheet Exporter"
        Width="1150" Height="780"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/OpenAEC.Sheets.UI;component/Styles/OpenAecTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <ObjectDataProvider x:Key="ColorModes" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="models:ColorMode" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <ObjectDataProvider x:Key="RasterQualities" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="models:RasterQuality" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <ObjectDataProvider x:Key="ImageFormats" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="models:ImageFormat" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="10">

        <!-- Header: profielen -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                Padding="10,6" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Profiel:" Style="{StaticResource SettingLabel}" FontWeight="SemiBold" />
                <ComboBox Width="200" Margin="0,0,8,0"
                          ItemsSource="{Binding ProfileNames}"
                          SelectedItem="{Binding SelectedProfileName}" />
                <TextBox Width="160" Style="{StaticResource SearchBox}" Margin="0,0,8,0"
                         Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Naam voor nieuw profiel (leeg = huidig profiel overschrijven)" />
                <Button Content="Opslaan" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Command="{Binding SaveProfileCommand}" />
                <Button Content="Verwijderen" Style="{StaticResource SecondaryButton}"
                        Command="{Binding DeleteProfileCommand}" />
            </StackPanel>
        </Border>

        <!-- Statusbalk -->
        <Border DockPanel.Dock="Bottom" Padding="4,6">
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
        </Border>

        <Grid>

        <TabControl Background="{StaticResource SurfaceBrush}">

            <!-- ═══ TAB 1: SELECTIE ═══ -->
            <TabItem Header="  Selectie  ">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton Content="Sheets" IsChecked="{Binding ShowSheets}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <RadioButton Content="Views" VerticalAlignment="Center" Margin="0,0,20,0" />
                        <TextBlock Text="View/Sheet Set:" Style="{StaticResource SettingLabel}" />
                        <ComboBox Width="220" Margin="0,0,20,0"
                                  ItemsSource="{Binding SetFilters}"
                                  SelectedItem="{Binding SelectedSetFilter}" />
                        <Button Content="Alles aan/uit" Style="{StaticResource SecondaryButton}" Margin="0,0,20,0"
                                Command="{Binding SelectAllVisibleCommand}" />
                        <TextBox Width="220" Style="{StaticResource SearchBox}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Zoek op nummer of naam" />
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Rows}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeight="26"
                              FontSize="12"
                              SelectionMode="Extended"
                              EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="36">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Nummer" Binding="{Binding Number}" Width="110" IsReadOnly="True" />
                            <DataGridTextColumn Header="Naam" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Revisie" Binding="{Binding Revision}" Width="80" IsReadOnly="True" />
                            <DataGridTextColumn Header="Formaat" Binding="{Binding Size}" Width="100" IsReadOnly="True" />
                            <DataGridTextColumn Header="Eigen bestandsnaam (optioneel)"
                                                Binding="{Binding CustomFileName, UpdateSourceTrigger=LostFocus}"
                                                Width="260" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ═══ TAB 2: FORMATEN ═══ -->
            <TabItem Header="  Formaten  ">
                <TabControl Margin="10" TabStripPlacement="Top">

                    <!-- PDF -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding PdfEnabled}" Click="OnFormatToggleClick" VerticalAlignment="Center" />
                                <TextBlock Text="PDF" FontWeight="SemiBold" Margin="4,0,2,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <WrapPanel Margin="10" Orientation="Horizontal">
                            <GroupBox Header="Weergave" Style="{StaticResource SettingsGroup}" Width="280">
                                <StackPanel>
                                    <CheckBox Content="Hidden lines via vector processing" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Pdf.VectorHiddenLines}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Text="Rasterkwaliteit:" Style="{StaticResource SettingLabel}" Width="100" />
                                        <ComboBox Width="140" ItemsSource="{Binding Source={StaticResource RasterQualities}}"
                                                  SelectedItem="{Binding Profile.Pdf.RasterQuality}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Text="Kleuren:" Style="{StaticResource SettingLabel}" Width="100" />
                                        <ComboBox Width="140" ItemsSource="{Binding Source={StaticResource ColorModes}}"
                                                  SelectedItem="{Binding Profile.Pdf.Colors}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Text="Kwaliteit (DPI):" Style="{StaticResource SettingLabel}" Width="100" />
                                        <ComboBox Width="140" ItemsSource="{Binding PdfQualityDpis}"
                                                  SelectedItem="{Binding Profile.Pdf.QualityDpi}" />
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Papier &amp; plaatsing" Style="{StaticResource SettingsGroup}" Width="280">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Text="Papierformaat:" Style="{StaticResource SettingLabel}" Width="100" />
                                        <ComboBox Width="140" ItemsSource="{Binding PdfPaperFormats}"
                                                  SelectedItem="{Binding Profile.Pdf.PaperFormat}"
                                                  ToolTip="Default = formaat van de sheet zelf" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Text="Oriëntatie:" Style="{StaticResource SettingLabel}" Width="100" />
                                        <ComboBox Width="140" ItemsSource="{Binding Orientations}"
                                                  SelectedItem="{Binding Profile.Pdf.Orientation}" />
                                    </StackPanel>
                                    <CheckBox Content="Fit to page" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Pdf.FitToPage}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Text="Zoom %:" Style="{StaticResource SettingLabel}" Width="100" />
                                        <TextBox Width="60" Style="{StaticResource SearchBox}"
                                                 Text="{Binding Profile.Pdf.ZoomPercentage}" />
                                    </StackPanel>
                                    <CheckBox Content="Papier centreren" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Pdf.CenterPaperPlacement}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Text="Offset X / Y (mm):" Style="{StaticResource SettingLabel}" Width="100" />
                                        <TextBox Width="55" Style="{StaticResource SearchBox}" Margin="0,0,6,0"
                                                 Text="{Binding Profile.Pdf.OriginOffsetXMm}" />
                                        <TextBox Width="55" Style="{StaticResource SearchBox}"
                                                 Text="{Binding Profile.Pdf.OriginOffsetYMm}" />
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Opties" Style="{StaticResource SettingsGroup}" Width="300">
                                <StackPanel>
                                    <CheckBox Content="View links in blauw" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Pdf.ViewLinksInBlue}" />
                                    <CheckBox Content="Verberg ref/work planes" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Pdf.HideRefWorkPlanes}" />
                                    <CheckBox Content="Verberg unreferenced view tags" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Pdf.HideUnreferencedViewTags}" />
                                    <CheckBox Content="Verberg scope boxes" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Pdf.HideScopeBoxes}" />
                                    <CheckBox Content="Verberg crop boundaries" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Pdf.HideCropBoundaries}" />
                                    <CheckBox Content="Halftone vervangen door dunne lijnen" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Pdf.ReplaceHalftoneWithThinLines}" />
                                    <CheckBox Content="Region edges maskeren coincident lines" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Pdf.MaskCoincidentLines}" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Bestand" Style="{StaticResource SettingsGroup}" Width="320">
                                <StackPanel>
                                    <RadioButton Content="Losse bestanden" GroupName="PdfFileMode" Margin="0,4"
                                                 IsChecked="{Binding PdfSeparateFiles}" />
                                    <RadioButton Content="Combineer alles in één PDF" GroupName="PdfFileMode" Margin="0,4"
                                                 IsChecked="{Binding PdfCombineAll}" />
                                    <RadioButton Content="Combineer per parameterwaarde:" GroupName="PdfFileMode" Margin="0,4"
                                                 IsChecked="{Binding PdfCombineByParameter}" />
                                    <ComboBox Margin="20,2,0,4"
                                              ItemsSource="{Binding SheetParameterNames}"
                                              SelectedItem="{Binding Profile.Pdf.GroupByParameter}"
                                              IsEnabled="{Binding PdfCombineByParameter}"
                                              ToolTip="Eén gecombineerde PDF per unieke waarde, bijv. per bouwdeel of discipline" />
                                    <CheckBox Content="Waarde splitsen (blad in meerdere boekjes)" Style="{StaticResource SettingCheck}"
                                              Margin="20,2,0,2"
                                              IsChecked="{Binding PdfSplitGroupValues}"
                                              IsEnabled="{Binding PdfCombineByParameter}"
                                              ToolTip="Splitst de parameterwaarde op ; of , — elk deel wordt een eigen gecombineerde PDF. Eén blad kan zo in meerdere boekjes komen." />
                                    <StackPanel Orientation="Horizontal" Margin="40,0,0,4"
                                                IsEnabled="{Binding PdfCombineByParameter}">
                                        <TextBlock Text="Scheidingstekens:" Style="{StaticResource SettingLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox Style="{StaticResource SearchBox}" Width="60"
                                                 Text="{Binding PdfGroupValueSeparators, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding PdfSplitGroupValues}"
                                                 ToolTip="Elk teken splitst afzonderlijk. Standaard ; en , — leeg = niet splitsen." />
                                    </StackPanel>
                                    <TextBlock Text="Bestandsnaam / prefix:" Style="{StaticResource SettingLabel}" Margin="0,6,0,2" />
                                    <TextBox Style="{StaticResource SearchBox}"
                                             Text="{Binding Profile.Pdf.CombinedFileName}"
                                             ToolTip="Bij 'combineer alles': basisnaam; projectnaam en printset-naam worden er automatisch achter gezet. Bij 'per parameterwaarde': prefix vóór de groepswaarde. Leeg = documentnaam / groepswaarde.&#x0a;Tokens toegestaan, bijv. {Project Number}_{tekening_fase} — dan wordt niets automatisch achtergevoegd; met {Group} bepaal je zelf waar de groepswaarde komt. Tokens worden opgelost via het eerste blad van het boekje." />
                                </StackPanel>
                            </GroupBox>
                        </WrapPanel>
                    </TabItem>

                    <!-- DWG -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding DwgEnabled}" Click="OnFormatToggleClick" VerticalAlignment="Center" />
                                <TextBlock Text="DWG" FontWeight="SemiBold" Margin="4,0,2,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <StackPanel Margin="10">
                            <GroupBox Header="Export setup" Style="{StaticResource SettingsGroup}" Width="420" HorizontalAlignment="Left">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Setup:" Style="{StaticResource SettingLabel}" Width="60" />
                                        <ComboBox Width="300" ItemsSource="{Binding DwgSetupNames}"
                                                  SelectedItem="{Binding Profile.Dwg.ExportSetupName}" />
                                    </StackPanel>
                                    <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                               Text="Setups beheer je in Revit via Export → DWG → Modify Export Setup." TextWrapping="Wrap" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Opties" Style="{StaticResource SettingsGroup}" Width="420" HorizontalAlignment="Left">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="AutoCAD-versie:" Style="{StaticResource SettingLabel}" Width="110" />
                                        <ComboBox Width="140" ItemsSource="{Binding DwgVersions}"
                                                  SelectedItem="{Binding Profile.Dwg.FileVersion}"
                                                  ToolTip="Default = versie uit de export setup" />
                                    </StackPanel>
                                    <CheckBox Content="Shared coordinates gebruiken" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Dwg.UseSharedCoordinates}" />
                                    <CheckBox Content="Views op sheets exporteren als externe referenties (Xrefs)"
                                              Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Dwg.ExportViewsOnSheetsAsXrefs}" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </TabItem>

                    <!-- DGN -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding DgnEnabled}" Click="OnFormatToggleClick" VerticalAlignment="Center" />
                                <TextBlock Text="DGN" FontWeight="SemiBold" Margin="4,0,2,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <StackPanel Margin="10">
                            <GroupBox Header="Export setup" Style="{StaticResource SettingsGroup}" Width="420" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Setup:" Style="{StaticResource SettingLabel}" Width="60" />
                                    <ComboBox Width="300" ItemsSource="{Binding DgnSetupNames}"
                                              SelectedItem="{Binding Profile.Dgn.ExportSetupName}" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </TabItem>

                    <!-- DWF -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding DwfEnabled}" Click="OnFormatToggleClick" VerticalAlignment="Center" />
                                <TextBlock Text="DWF" FontWeight="SemiBold" Margin="4,0,2,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <WrapPanel Margin="10">
                            <GroupBox Header="Opties" Style="{StaticResource SettingsGroup}" Width="300">
                                <StackPanel>
                                    <CheckBox Content="DWFx (i.p.v. DWF)" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Dwf.UseDwfx}" />
                                    <CheckBox Content="Lossless afbeeldingen" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Dwf.LosslessImages}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="Beeldkwaliteit:" Style="{StaticResource SettingLabel}" Width="90" />
                                        <ComboBox Width="120" ItemsSource="{Binding DwfQualities}"
                                                  SelectedItem="{Binding Profile.Dwf.ImageQuality}"
                                                  ToolTip="Alleen relevant bij lossy afbeeldingen" />
                                    </StackPanel>
                                    <CheckBox Content="Element properties exporteren" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Dwf.ExportElementProperties}" />
                                    <CheckBox Content="Textures exporteren" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Dwf.ExportTextures}" />
                                    <CheckBox Content="Crop box zichtbaar" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Dwf.CropBoxVisible}" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Bestand" Style="{StaticResource SettingsGroup}" Width="300">
                                <StackPanel>
                                    <CheckBox Content="Combineer in één bestand" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Dwf.Combine}" />
                                    <TextBlock Text="Bestandsnaam:" Style="{StaticResource SettingLabel}" Margin="0,6,0,2" />
                                    <TextBox Style="{StaticResource SearchBox}"
                                             Text="{Binding Profile.Dwf.CombinedFileName}"
                                             IsEnabled="{Binding Profile.Dwf.Combine}" />
                                </StackPanel>
                            </GroupBox>
                        </WrapPanel>
                    </TabItem>

                    <!-- NWC -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding NwcEnabled}" Click="OnFormatToggleClick" VerticalAlignment="Center" />
                                <TextBlock Text="NWC" FontWeight="SemiBold" Margin="4,0,2,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <WrapPanel Margin="10">
                            <GroupBox Header="Algemeen" Style="{StaticResource SettingsGroup}" Width="320">
                                <StackPanel>
                                    <CheckBox Content="Element properties converteren" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Nwc.ConvertElementProperties}" />
                                    <CheckBox Content="Shared coordinates gebruiken" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Nwc.UseSharedCoordinates}" />
                                    <CheckBox Content="Gelinkte bestanden meenemen" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Nwc.ExportLinks}" />
                                    <CheckBox Content="Gelinkte CAD-formaten converteren" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Nwc.ConvertLinkedCadFormats}" />
                                    <CheckBox Content="Bestand opdelen per bouwlaag" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Nwc.DivideFileIntoLevels}" />
                                    <CheckBox Content="Element-ID's exporteren" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Nwc.ExportElementIds}" />
                                    <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                               Text="Vereist de Navisworks-exporter voor Revit 2025." TextWrapping="Wrap" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Inhoud &amp; geometrie" Style="{StaticResource SettingsGroup}" Width="320">
                                <StackPanel>
                                    <CheckBox Content="Parts exporteren" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Nwc.ExportParts}" />
                                    <CheckBox Content="Ruimten als attribuut" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Nwc.ExportRoomAsAttribute}" />
                                    <CheckBox Content="Ruimte-geometrie exporteren" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Nwc.ExportRoomGeometry}" />
                                    <CheckBox Content="URL's exporteren" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Nwc.ExportUrls}" />
                                    <CheckBox Content="Lichten converteren" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Nwc.ConvertLights}" />
                                    <CheckBox Content="Ontbrekende materialen zoeken" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Nwc.FindMissingMaterials}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Text="Faceting factor:" Style="{StaticResource SettingLabel}" Width="100" />
                                        <TextBox Width="60" Style="{StaticResource SearchBox}"
                                                 Text="{Binding Profile.Nwc.FacetingFactor}"
                                                 ToolTip="0.1 (grof) t/m 10 (fijn), standaard 1.0" />
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                        </WrapPanel>
                    </TabItem>

                    <!-- IFC -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IfcEnabled}" Click="OnFormatToggleClick" VerticalAlignment="Center" />
                                <TextBlock Text="IFC" FontWeight="SemiBold" Margin="4,0,2,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <WrapPanel Margin="10">
                            <GroupBox Header="Algemeen" Style="{StaticResource SettingsGroup}" Width="300">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="IFC-versie:" Style="{StaticResource SettingLabel}" Width="110" />
                                        <ComboBox Width="140" ItemsSource="{Binding IfcVersions}"
                                                  SelectedItem="{Binding Profile.Ifc.Version}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="Space boundaries:" Style="{StaticResource SettingLabel}" Width="110" />
                                        <ComboBox Width="140" SelectedIndex="{Binding Profile.Ifc.SpaceBoundaries}">
                                            <ComboBoxItem Content="Geen" />
                                            <ComboBoxItem Content="1st level" />
                                            <ComboBoxItem Content="2nd level" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="Fase:" Style="{StaticResource SettingLabel}" Width="110" />
                                        <ComboBox Width="140" ItemsSource="{Binding PhaseNames}"
                                                  SelectedItem="{Binding Profile.Ifc.PhaseName}"
                                                  ToolTip="Welke fase geëxporteerd wordt — (standaard) volgt de view/Revit-default" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="Category mapping:" Style="{StaticResource SettingLabel}" Width="110" />
                                        <ComboBox Width="140" ItemsSource="{Binding CategoryMappingNames}"
                                                  SelectedItem="{Binding Profile.Ifc.CategoryMappingTemplate}"
                                                  ToolTip="IFC category mapping template uit het document" />
                                    </StackPanel>
                                    <TextBlock Text="Of mapping-bestand (.txt):" Style="{StaticResource SettingLabel}" Margin="0,4,0,2" />
                                    <TextBox Style="{StaticResource SearchBox}"
                                             Text="{Binding Profile.Ifc.CategoryMappingFile}"
                                             ToolTip="Pad naar categorymapping-bestand; wordt geïmporteerd en geactiveerd vóór export (gaat vóór de template-keuze)" />
                                    <CheckBox Content="Wanden/kolommen splitsen per bouwlaag" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Ifc.WallAndColumnSplitting}" />
                                    <CheckBox Content="Steel elements meenemen" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Ifc.IncludeSteelElements}" />
                                    <CheckBox Content="Alleen zichtbare elementen in view" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Ifc.VisibleElementsOfCurrentView}" />
                                    <CheckBox Content="2D-elementen exporteren" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Ifc.Export2DElements}" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Property sets" Style="{StaticResource SettingsGroup}" Width="320">
                                <StackPanel>
                                    <CheckBox Content="Revit property sets" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Ifc.ExportInternalRevitPropertySets}" />
                                    <CheckBox Content="IFC Common property sets" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Ifc.ExportIfcCommonPropertySets}" />
                                    <CheckBox Content="Base quantities" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Ifc.ExportBaseQuantities}" />
                                    <CheckBox Content="Schedules als property sets" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Ifc.ExportSchedulesAsPsets}" />
                                    <CheckBox Content="User defined property sets:" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Ifc.ExportUserDefinedPsets}" />
                                    <TextBox Style="{StaticResource SearchBox}"
                                             Text="{Binding Profile.Ifc.UserDefinedPsetsPath}"
                                             IsEnabled="{Binding Profile.Ifc.ExportUserDefinedPsets}"
                                             ToolTip="Pad naar .txt met pset-definities" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Geavanceerd" Style="{StaticResource SettingsGroup}" Width="300">
                                <StackPanel>
                                    <CheckBox Content="Parts als building elements" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Ifc.ExportPartsAsBuildingElements}" />
                                    <CheckBox Content="Active view geometry gebruiken" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Ifc.UseActiveViewGeometry}" />
                                    <CheckBox Content="Bounding box exporteren" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Ifc.ExportBoundingBox}" />
                                    <CheckBox Content="IFC GUID opslaan in parameter" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Ifc.StoreIfcGuid}" />
                                    <CheckBox Content="Gelinkte bestanden exporteren" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Ifc.ExportLinkedFiles}" />
                                    <CheckBox Content="Ruimten in view exporteren" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Ifc.ExportRoomsInView}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Text="Detailniveau:" Style="{StaticResource SettingLabel}" Width="90" />
                                        <ComboBox Width="90" ItemsSource="{Binding TessellationLevels}"
                                                  SelectedItem="{Binding Profile.Ifc.TessellationLevelOfDetail}"
                                                  ToolTip="Tessellatie: 0.25 = laag, 1.0 = hoogst" />
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                        </WrapPanel>
                    </TabItem>

                    <!-- IMG -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding ImgEnabled}" Click="OnFormatToggleClick" VerticalAlignment="Center" />
                                <TextBlock Text="IMG" FontWeight="SemiBold" Margin="4,0,2,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <WrapPanel Margin="10">
                            <GroupBox Header="Afbeeldingsgrootte" Style="{StaticResource SettingsGroup}" Width="300">
                                <StackPanel>
                                    <CheckBox Content="Fit naar pixelgrootte:" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Img.FitToPixelSize}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="Pixels:" Style="{StaticResource SettingLabel}" Width="70" />
                                        <TextBox Width="90" Style="{StaticResource SearchBox}"
                                                 Text="{Binding Profile.Img.PixelSize}" />
                                    </StackPanel>
                                    <CheckBox Content="Horizontale richting" Style="{StaticResource SettingCheck}"
                                              IsChecked="{Binding Profile.Img.FitDirectionHorizontal}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="Zoom %:" Style="{StaticResource SettingLabel}" Width="70" />
                                        <TextBox Width="90" Style="{StaticResource SearchBox}"
                                                 Text="{Binding Profile.Img.ZoomPercentage}" />
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Formaat" Style="{StaticResource SettingsGroup}" Width="300">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="Shaded views:" Style="{StaticResource SettingLabel}" Width="110" />
                                        <ComboBox Width="120" ItemsSource="{Binding Source={StaticResource ImageFormats}}"
                                                  SelectedItem="{Binding Profile.Img.ShadedFormat}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="Non-shaded views:" Style="{StaticResource SettingLabel}" Width="110" />
                                        <ComboBox Width="120" ItemsSource="{Binding Source={StaticResource ImageFormats}}"
                                                  SelectedItem="{Binding Profile.Img.NonShadedFormat}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="DPI:" Style="{StaticResource SettingLabel}" Width="90" />
                                        <ComboBox Width="120" SelectedItem="{Binding Profile.Img.Dpi}">
                                            <sys:Int32>72</sys:Int32>
                                            <sys:Int32>150</sys:Int32>
                                            <sys:Int32>300</sys:Int32>
                                            <sys:Int32>600</sys:Int32>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                        </WrapPanel>
                    </TabItem>

                    <!-- XML -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding XmlEnabled}" Click="OnFormatToggleClick" VerticalAlignment="Center" />
                                <TextBlock Text="XML" FontWeight="SemiBold" Margin="4,0,2,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <DockPanel Margin="10">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Bestandsnaam:" Style="{StaticResource SettingLabel}" />
                                <TextBox Width="260" Style="{StaticResource SearchBox}"
                                         Text="{Binding Profile.Xml.FileName}"
                                         ToolTip="Leeg = documentnaam" />
                                <TextBlock Text="   Aangevinkte parameters worden per sheet/view als XML-element weggeschreven (leeg = alle)."
                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" FontSize="11" />
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding XmlParameters}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Vertical" MaxHeight="440" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"
                                                      Margin="4,2" FontSize="12" Width="240" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                </TabControl>
            </TabItem>

            <!-- ═══ TAB 3: EXPORTEREN ═══ -->
            <TabItem Header="  Exporteren  ">
                <DockPanel Margin="10">

                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Exportmap:" Style="{StaticResource SettingLabel}" Width="110" />
                            <TextBox Width="500" Style="{StaticResource SearchBox}"
                                     Text="{Binding Profile.OutputFolder, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="Bladeren…" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Click="OnBrowseFolder" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Naamtemplate:" Style="{StaticResource SettingLabel}" Width="110" />
                            <TextBox x:Name="NamingTemplateBox" Width="500" Style="{StaticResource SearchBox}"
                                     Text="{Binding NamingTemplate, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Vaste tekst en {tokens} vrij te combineren, bijv. TO_{Sheet Number}_{Sheet Name} of {Project Number}_{tekening_fase}_{Sheet Number}" />
                            <CheckBox Content="Submap per formaat" Margin="16,0,0,0" VerticalAlignment="Center"
                                      IsChecked="{Binding Profile.SplitByFormat}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Token:" Style="{StaticResource SettingLabel}" Width="110" />
                            <ComboBox Width="300" ItemsSource="{Binding NamingTokens}"
                                      SelectedItem="{Binding SelectedNamingToken}"
                                      ToolTip="Document-tokens (Project Name/Number, Document Title, Sheet Set) en alle sheet- en titleblock-parameters" />
                            <Button Content="Invoegen" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Click="OnInsertNamingToken" ToolTip="Voegt {token} in op de cursorpositie in de naamtemplate" />
                        </StackPanel>
                        <TextBlock Margin="114,0,0,2" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                   Text="Vaste tekst mag overal: TO_{Sheet Number}_{Sheet Name}. Tokens: alle sheet- en titleblock-parameters plus {Project Name}, {Project Number}, {Document Title}, {Sheet Set}. Eigen bestandsnaam op tabblad Selectie overschrijft de template." />
                        <TextBlock Margin="114,0,0,8" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"
                                   Text="{Binding NamingPreview}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Voorbeeld vernieuwen" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RefreshJobsCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <ProgressBar Height="16" Value="{Binding ProgressValue}" Maximum="100" />
                        <DockPanel Margin="0,6,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Annuleren" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                        Command="{Binding CancelExportCommand}"
                                        Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}" />
                                <Button Content="Exporteren" Style="{StaticResource PrimaryButton}" MinWidth="120"
                                        Command="{Binding ExportCommand}" />
                            </StackPanel>
                            <TextBlock Text="{Binding ProgressText}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                        </DockPanel>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Jobs}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeight="24"
                              FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nummer" Binding="{Binding Number}" Width="100" />
                            <DataGridTextColumn Header="Naam" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Formaat" Binding="{Binding Format}" Width="80" />
                            <DataGridTextColumn Header="Bestandsnaam" Binding="{Binding FileName}" Width="300" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="200" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

        </TabControl>

        <!-- Laad-overlay tijdens het lezen van het model -->
        <Border Background="#D9FFFFFF"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="380">
                <TextBlock Text="{Binding LoadingText}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"
                           FontSize="13"
                           Foreground="{StaticResource TextBrush}" />
                <ProgressBar IsIndeterminate="True" Height="14" Foreground="{StaticResource AmberBrush}" />
            </StackPanel>
        </Border>

        </Grid>
    </DockPanel>
</Window>
